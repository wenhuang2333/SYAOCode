{
  "name": "syaocode-monorepo",
  "private": true,
  "version": "0.2.0-dev",
  "description": "SYAOCode \u2014 TypeScript coding-agent harness library + reference CLI (v0.1 internal, M0+M1)",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "start": "tsx packages/cli/src/main.ts",
    "cli": "tsx packages/cli/src/main.ts",
    "build": "pnpm --filter @syaocode/core run build && pnpm --filter @syaocode/node run build && pnpm --filter @syaocode/rpc run build && pnpm --filter @syaocode/protocols run build && pnpm --filter \"@syaocode/providers\" --filter \"@syaocode/tools\" --filter \"@syaocode/testing\" run build && pnpm --filter syaocode run build",
    "typecheck": "pnpm -r --workspace-concurrency=2 --filter './packages/*' run typecheck",
    "test": "pnpm -r --workspace-concurrency=2 --filter './packages/*' run test",
    "test:evals": "pnpm exec tsx evals/run-eval.ts",
    "lint:registry": "pnpm exec tsx scripts/check-error-registry.ts",
    "lint:core": "pnpm exec tsx scripts/check-core-purity.ts",
    "lint:rpc": "pnpm exec tsx scripts/check-rpc-boundaries.ts",
    "lint": "pnpm run lint:registry && pnpm run lint:core && pnpm run lint:rpc",
    "fixtures:gen": "pnpm exec tsx scripts/gen-wire-fixture.ts",
    "build:check": "pnpm exec tsx scripts/check-build-artifact.ts",
    "test:coverage": "pnpm --filter @syaocode/rpc run test:coverage"
  },
  "devDependencies": {
    "@syaocode/core": "workspace:*",
    "@syaocode/node": "workspace:*",
    "@syaocode/protocols": "workspace:*",
    "@syaocode/rpc": "workspace:*",
    "@syaocode/testing": "workspace:*",
    "@syaocode/tools": "workspace:*",
    "@vitest/coverage-v8": "3.2.7",
    "tsx": "^4.19.0"
  }
}
