{
  "name": "syaocode-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "SYAOCode — TypeScript coding-agent harness library + reference CLI (v0.1 internal, M0+M1)",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "start": "tsx packages/cli/src/main.ts",
    "cli": "tsx packages/cli/src/main.ts",
    "build": "pnpm --filter @syaocode/core run build && pnpm --filter \"@syaocode/providers\" --filter \"@syaocode/tools\" --filter \"@syaocode/testing\" run build && pnpm --filter syaocode run build",
    "typecheck": "pnpm -r --filter './packages/*' run typecheck",
    "test": "pnpm -r --filter './packages/*' run test",
    "test:evals": "pnpm exec tsx evals/run-eval.ts",
    "lint:registry": "pnpm exec tsx scripts/check-error-registry.ts"
  },
  "devDependencies": {
    "@syaocode/core": "workspace:*",
    "@syaocode/testing": "workspace:*",
    "@syaocode/tools": "workspace:*",
    "tsx": "^4.19.0"
  }
}
