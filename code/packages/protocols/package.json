{
  "name": "@syaocode/protocols",
  "version": "0.3.0-dev",
  "description": "SYAOCode protocol edges: MCP / A2A / ACP adapters wrapping the ARF governance kernel",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./mcp": "./src/mcp/index.ts",
    "./a2a": "./src/a2a/index.ts",
    "./acp": "./src/acp/index.ts",
    "./shared": "./src/shared/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run typecheck && pnpm run build"
  },
  "dependencies": {
    "@syaocode/core": "workspace:*",
    "@syaocode/rpc": "workspace:*",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wenhuang2333/SYAOCode.git"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./mcp": {
        "types": "./dist/mcp/index.d.ts",
        "default": "./dist/mcp/index.js"
      },
      "./a2a": {
        "types": "./dist/a2a/index.d.ts",
        "default": "./dist/a2a/index.js"
      },
      "./acp": {
        "types": "./dist/acp/index.d.ts",
        "default": "./dist/acp/index.js"
      },
      "./shared": {
        "types": "./dist/shared/index.d.ts",
        "default": "./dist/shared/index.js"
      }
    }
  }
}
