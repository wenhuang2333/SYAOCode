{
  "name": "liwencode-desktop-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "LIWENCode Desktop: Electron shell + DHP host/client/ui",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --workspace-concurrency=2 run typecheck",
    "test": "pnpm -r --workspace-concurrency=2 run test",
    "build": "pnpm --filter @liwencode/host run build && pnpm --filter liwencode-desktop run build",
    "build:host": "pnpm --filter @liwencode/host run build",
    "verify:layout": "node scripts/verify-layout.mjs",
    "verify:theme": "node scripts/verify-theme.mjs",
    "verify:smoke": "node scripts/smoke-electron.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify:interaction": "node scripts/verify-interaction.mjs",
    "verify:real-model": "node --import tsx scripts/verify-real-model.mjs",
    "verify:real-window": "node --import tsx scripts/verify-real-window.mjs",
    "verify:real-commit-message": "node --import tsx scripts/verify-real-commit-message.mjs",
    "verify:real-usage": "node --import tsx scripts/verify-real-usage.mjs",
    "verify:real-tool-use": "node --import tsx scripts/verify-real-tool-use.mjs",
    "verify:real-approval": "node --import tsx scripts/verify-real-approval.mjs",
    "verify:steer": "node --import tsx scripts/verify-steer.mjs",
    "dev:host": "pnpm run build:host && node scripts/dev-host.mjs",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "package:dir": "pnpm run build && pnpm --filter liwencode-desktop run package:dir",
    "package:mac": "pnpm run build && pnpm --filter liwencode-desktop run package:mac",
    "package:win": "pnpm run build && pnpm --filter liwencode-desktop run package:win",
    "package:linux": "pnpm run build && pnpm --filter liwencode-desktop run package:linux"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
