{
  "name": "liwencode-desktop",
  "version": "0.1.0",
  "description": "LIWENCode Desktop: Electron shell (main + preload + renderer)",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "package:dir": "electron-builder --dir",
    "package:mac": "electron-builder --mac",
    "package:win": "electron-builder --win",
    "package:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@liwencode/client": "workspace:*",
    "@liwencode/dhp": "workspace:*",
    "@liwencode/host": "workspace:*",
    "@liwencode/ui": "workspace:*",
    "lucide-react": "^1.72.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.7.2",
    "vite": "^8.0.0",
    "vitest": "^3.2.4"
  }
}
